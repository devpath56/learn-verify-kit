    "last_score": "string|number — most recent result (e.g. 4.3, 'pass', 'fail')",
    "last_reviewed": "string|null — ISO date YYYY-MM-DD of the last recall, or null if never reviewed",
    "next_review": "string — ISO date YYYY-MM-DD when this topic is due again",
    "gaps": "object — running count per miss code {name, mechanism, boundary, price, phrasing}; see house-style.md 'Record the gap'",
